# Artemis local runtime configuration template.
# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Primary Ethereum RPC endpoints. Artemis live collectors use WSS.
ETHEREUM_RPC_URL=https://your-quicknode-http-endpoint
ETHEREUM_WSS_URL=wss://your-quicknode-wss-endpoint

# Bot/searcher wallet. Use a fresh wallet with limited funds, not your main wallet.
PRIVATE_KEY=0x...

# OpenSea sudo arb example.
OPENSEA_API_KEY=
ARB_CONTRACT_ADDRESS=0x...
BID_PERCENTAGE=80

# MEV-share / Flashbots example.
FLASHBOTS_SIGNER=0x...
MEV_SHARE_URL=https://mev-share.flashbots.net
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Optional AgentCash-paid signal/risk endpoints.
AGENTCASH_MEV_SHIELD_URL=https://x402helper.xyz/mev-shield
AGENTCASH_MEV_RISK_URL=https://x402helper.xyz/api/mev-risk
